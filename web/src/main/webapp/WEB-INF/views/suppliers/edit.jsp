<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="vn.ptit.pttkm3.model.NhaCungCap,vn.ptit.pttkm3.web.SecuritySupport" %>
<%NhaCungCap supplier=(NhaCungCap)request.getAttribute("supplier"); String name=(String)request.getAttribute("oldName"),address=(String)request.getAttribute("oldAddress"),phone=(String)request.getAttribute("oldPhone"),email=(String)request.getAttribute("oldEmail"),returnQuery=(String)request.getAttribute("returnQuery"); if(returnQuery==null)returnQuery=request.getParameter("returnQuery"); if(returnQuery==null)returnQuery=""; Object returnPageValue=request.getAttribute("returnPage"); int returnPage=returnPageValue instanceof Integer?(Integer)returnPageValue:1; try{if(returnPageValue==null&&request.getParameter("returnPage")!=null)returnPage=Math.max(1,Integer.parseInt(request.getParameter("returnPage")));}catch(RuntimeException ignored){} String error=(String)request.getAttribute("error"); boolean lengthError=error!=null&&error.contains("vượt độ dài"),contactConflict=error!=null&&error.contains("Số điện thoại hoặc email"),nameError=error!=null&&(error.contains("Tên nhà cung cấp")||lengthError),addressError=error!=null&&(error.contains("Địa chỉ")||lengthError),phoneError=error!=null&&(error.contains("Số điện thoại")||lengthError),emailError=error!=null&&(error.contains("Email")||contactConflict);%>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sửa nhà cung cấp · Truyện Nhà Mình</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body>
<jsp:include page="/WEB-INF/views/partials/top.jsp" /><main class="wrap">
  <div class="page-intro"><div class="eyebrow">Nhà cung cấp</div><h1>Sửa thông tin nhà cung cấp</h1><p class="lead">Mã nhà cung cấp được tạo tự động và không thể chỉnh sửa.</p></div>
  <%if(error!=null){%><div id="error-summary" class="alert error" role="alert" tabindex="-1"><strong>Chưa thể lưu thay đổi.</strong><br><%=SecuritySupport.escape(error)%></div><script>document.getElementById('error-summary').focus();</script><%}%>
  <%if(Boolean.TRUE.equals(request.getAttribute("stale"))){%>
    <section class="card card-body"><h2>Thông tin đã được cập nhật ở nơi khác</h2><p>Dữ liệu hiện tại của nhà cung cấp là <strong><%=SecuritySupport.escape(supplier.getTenNCC())%></strong> (phiên bản <%=supplier.getVersion()%>). Tải bản mới nhất trước khi sửa tiếp.</p><div class="footer-actions"><a class="btn" href="${pageContext.request.contextPath}/app/suppliers?q=<%=java.net.URLEncoder.encode(returnQuery,java.nio.charset.StandardCharsets.UTF_8)%>&amp;page=<%=returnPage%>">Hủy</a><a class="btn primary" href="${pageContext.request.contextPath}/app/suppliers/edit?id=<%=supplier.getId()%>&amp;q=<%=java.net.URLEncoder.encode(returnQuery,java.nio.charset.StandardCharsets.UTF_8)%>&amp;page=<%=returnPage%>">Tải thông tin mới</a></div></section>
  <%}else{%>
  <form method="post" action="${pageContext.request.contextPath}/app/suppliers/edit" class="card card-body form-grid">
    <input type="hidden" name="_csrf" value="<%=SecuritySupport.escape((String)request.getAttribute("csrfToken"))%>"><input type="hidden" name="id" value="<%=supplier.getId()%>"><input type="hidden" name="version" value="<%=supplier.getVersion()%>"><input type="hidden" name="editToken" value="<%=SecuritySupport.escape((String)request.getAttribute("editToken"))%>"><input type="hidden" name="returnQuery" value="<%=SecuritySupport.escape(returnQuery)%>"><input type="hidden" name="returnPage" value="<%=returnPage%>">
    <div class="field"><label for="supplier-code">Mã nhà cung cấp</label><input id="supplier-code" readonly value="<%=SecuritySupport.escape(supplier.getMaNCC())%>"><span class="field-help">Mã được hệ thống cấp tự động.</span></div>
    <div class="field"><label for="supplier-name">Tên nhà cung cấp <span class="req">*</span></label><input id="supplier-name" required maxlength="255" name="name" autocomplete="organization" value="<%=SecuritySupport.escape(name==null?supplier.getTenNCC():name)%>" <%=nameError?"aria-invalid=\"true\" aria-describedby=\"supplier-name-error\"":""%>><%if(nameError){%><p class="field-error" id="supplier-name-error"><%=SecuritySupport.escape(error)%></p><%}%></div>
    <div class="field"><label for="supplier-address">Địa chỉ <span class="req">*</span></label><input id="supplier-address" required maxlength="500" name="address" autocomplete="street-address" value="<%=SecuritySupport.escape(address==null?supplier.getDiaChi():address)%>" <%=addressError?"aria-invalid=\"true\" aria-describedby=\"supplier-address-error\"":""%>><%if(addressError){%><p class="field-error" id="supplier-address-error"><%=SecuritySupport.escape(error)%></p><%}%></div>
    <div class="field"><label for="supplier-phone">Số điện thoại <span class="req">*</span></label><input id="supplier-phone" required type="tel" maxlength="16" name="phone" autocomplete="tel" value="<%=SecuritySupport.escape(phone==null?supplier.getSoDienThoai():phone)%>" <%=phoneError?"aria-invalid=\"true\" aria-describedby=\"supplier-phone-error\"":""%>><%if(phoneError){%><p class="field-error" id="supplier-phone-error"><%=SecuritySupport.escape(error)%></p><%}%></div>
    <div class="field"><label for="supplier-email">Email <span class="req">*</span></label><input id="supplier-email" required type="email" maxlength="254" name="email" autocomplete="email" value="<%=SecuritySupport.escape(email==null?supplier.getEmail():email)%>" <%=emailError?"aria-invalid=\"true\" aria-describedby=\"supplier-email-error\"":""%>><%if(emailError){%><p class="field-error" id="supplier-email-error"><%=SecuritySupport.escape(error)%></p><%}%></div>
    <div class="footer-actions form-actions"><a class="btn" href="${pageContext.request.contextPath}/app/suppliers?q=<%=java.net.URLEncoder.encode(returnQuery,java.nio.charset.StandardCharsets.UTF_8)%>&amp;page=<%=returnPage%>">Hủy</a><button class="btn primary" type="submit">Lưu thay đổi</button></div>
  </form><%}%>
</main></body></html>
