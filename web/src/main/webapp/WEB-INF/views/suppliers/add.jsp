<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="vn.ptit.pttkm3.web.SecuritySupport,vn.ptit.pttkm3.service.ImportDraft" %>
<%String back=(String)request.getAttribute("returnTo"); if(back==null)back=request.getParameter("returnTo"); if(!"import".equals(back))back="find"; String draftId=(String)request.getAttribute("draftId"),searchQuery=(String)request.getAttribute("searchQuery"),error=(String)request.getAttribute("error"); if(searchQuery==null)searchQuery=request.getParameter("q"); if(searchQuery==null)searchQuery=""; Object pageObject=request.getAttribute("searchPage"); int searchPage=pageObject instanceof Integer?(Integer)pageObject:1; try{if(pageObject==null&&request.getParameter("page")!=null)searchPage=Math.max(1,Integer.parseInt(request.getParameter("page")));}catch(RuntimeException ignored){} ImportDraft activeDraft=(ImportDraft)request.getAttribute("draft"); boolean lengthError=error!=null&&error.contains("vượt độ dài"),contactConflict=error!=null&&error.contains("Số điện thoại hoặc email"),nameError=error!=null&&(error.contains("Tên nhà cung cấp")||lengthError),addressError=error!=null&&(error.contains("Địa chỉ")||lengthError),phoneError=error!=null&&(error.contains("Số điện thoại")||lengthError),emailError=error!=null&&(error.contains("Email")||contactConflict);%>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Thêm nhà cung cấp · Truyện Nhà Mình</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body>
<jsp:include page="/WEB-INF/views/partials/top.jsp" /><main class="wrap">
  <div class="page-intro"><div class="eyebrow">Nhà cung cấp</div><h1>Thêm nhà cung cấp</h1><p class="lead">Nhập thông tin liên hệ để nhân viên dùng trong nghiệp vụ nhập truyện.</p></div>
  <%if(request.getAttribute("error")!=null){%><div id="error-summary" class="alert error" role="alert" tabindex="-1"><strong>Chưa thể thêm nhà cung cấp.</strong><br><%=SecuritySupport.escape((String)request.getAttribute("error"))%></div><script>document.getElementById('error-summary').focus();</script><%}%>
  <form method="post" action="${pageContext.request.contextPath}/app/suppliers/add" class="card card-body form-grid">
    <input type="hidden" name="returnTo" value="<%=back%>"><input type="hidden" name="draftId" value="<%=SecuritySupport.escape(draftId)%>"><input type="hidden" name="q" value="<%=SecuritySupport.escape(searchQuery)%>"><input type="hidden" name="page" value="<%=searchPage%>"><input type="hidden" name="_csrf" value="<%=SecuritySupport.escape((String)request.getAttribute("csrfToken"))%>">
    <div class="field"><label for="supplier-name">Tên nhà cung cấp <span class="req">*</span></label><input id="supplier-name" name="name" required maxlength="255" autocomplete="organization" value="<%=SecuritySupport.escape((String)request.getAttribute("name"))%>" <%=nameError?"aria-invalid=\"true\" aria-describedby=\"supplier-name-error\"":""%>><%if(nameError){%><p class="field-error" id="supplier-name-error"><%=SecuritySupport.escape(error)%></p><%}%></div>
    <div class="field"><label for="supplier-address">Địa chỉ <span class="req">*</span></label><input id="supplier-address" name="address" required maxlength="500" autocomplete="street-address" value="<%=SecuritySupport.escape((String)request.getAttribute("address"))%>" <%=addressError?"aria-invalid=\"true\" aria-describedby=\"supplier-address-error\"":""%>><%if(addressError){%><p class="field-error" id="supplier-address-error"><%=SecuritySupport.escape(error)%></p><%}%></div>
    <div class="field"><label for="supplier-phone">Số điện thoại <span class="req">*</span></label><input id="supplier-phone" name="phone" type="tel" required maxlength="16" autocomplete="tel" placeholder="+84912345678" value="<%=SecuritySupport.escape((String)request.getAttribute("phone"))%>" <%=phoneError?"aria-invalid=\"true\" aria-describedby=\"supplier-phone-error\"":""%>><%if(phoneError){%><p class="field-error" id="supplier-phone-error"><%=SecuritySupport.escape(error)%></p><%}%></div>
    <div class="field"><label for="supplier-email">Email <span class="req">*</span></label><input id="supplier-email" name="email" type="email" required maxlength="254" autocomplete="email" value="<%=SecuritySupport.escape((String)request.getAttribute("email"))%>" <%=emailError?"aria-invalid=\"true\" aria-describedby=\"supplier-email-error\"":""%>><%if(emailError){%><p class="field-error" id="supplier-email-error"><%=SecuritySupport.escape(error)%></p><%}%></div>
    <div class="footer-actions form-actions"><a class="btn" href="${pageContext.request.contextPath}/app/<%="import".equals(back)?"imports?q="+java.net.URLEncoder.encode(searchQuery,java.nio.charset.StandardCharsets.UTF_8)+"&amp;page="+searchPage+(draftId==null||draftId.isBlank()?"":"&amp;draftId="+java.net.URLEncoder.encode(draftId,java.nio.charset.StandardCharsets.UTF_8)):"suppliers?q="+java.net.URLEncoder.encode(searchQuery,java.nio.charset.StandardCharsets.UTF_8)+"&amp;page="+searchPage%>">Hủy</a><button class="btn primary" type="submit">Thêm nhà cung cấp</button></div>
  </form>
</main></body></html>
