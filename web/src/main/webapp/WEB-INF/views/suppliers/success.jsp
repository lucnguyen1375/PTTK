<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="vn.ptit.pttkm3.web.SecuritySupport,vn.ptit.pttkm3.service.ImportDraft" %>
<%String successType=(String)request.getAttribute("successType"),returnTo=(String)request.getAttribute("returnTo"),draftId=(String)request.getAttribute("draftId"),searchQuery=(String)request.getAttribute("searchQuery"); Integer searchPage=(Integer)request.getAttribute("searchPage"); if(searchQuery==null)searchQuery=""; if(searchPage==null)searchPage=1; ImportDraft draft=(ImportDraft)request.getAttribute("draft"); boolean added="add".equals(successType); String encodedQuery=java.net.URLEncoder.encode(searchQuery,java.nio.charset.StandardCharsets.UTF_8); String destination=added?"import".equals(returnTo)?"/app/imports?q="+encodedQuery+"&amp;page="+searchPage+(draft==null?"":"&amp;draftId="+java.net.URLEncoder.encode(draftId,java.nio.charset.StandardCharsets.UTF_8)):"/app/suppliers?q="+encodedQuery+"&amp;page="+searchPage:"/app/home"; String actionLabel=added?"import".equals(returnTo)?"Trở lại chọn nhà cung cấp":"Trở lại danh sách nhà cung cấp":"Về trang chính";%>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=added?"Đã thêm nhà cung cấp":"Đã cập nhật nhà cung cấp"%> · Truyện Nhà Mình</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body>
<jsp:include page="/WEB-INF/views/partials/top.jsp" /><main class="wrap"><section class="card card-body" style="max-width:720px;margin:32px auto">
  <div class="alert success" role="status"><strong><%=added?"Đã thêm nhà cung cấp thành công.":"Đã cập nhật nhà cung cấp thành công."%></strong></div>
  <div class="eyebrow">Nhà cung cấp</div><h1><%=added?"Thông tin đã được lưu":"Thay đổi đã được lưu"%></h1>
  <%if(added&&"import".equals(returnTo)){%><p class="lead">Tiếp tục bằng cách trở lại danh sách chọn nhà cung cấp cho phiếu nhập.</p><%}else if(!added){%><p class="lead">Bạn có thể quay về trang chính để tiếp tục công việc.</p><%}else{%><p class="lead">Nhà cung cấp mới đã có thể được tìm kiếm và chỉnh sửa.</p><%}%>
  <div class="footer-actions" style="margin-top:22px"><a class="btn primary" href="${pageContext.request.contextPath}<%=destination%>"><%=actionLabel%></a></div>
</section></main></body></html>
