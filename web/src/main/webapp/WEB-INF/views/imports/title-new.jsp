<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="vn.ptit.pttkm3.service.ImportDraft,vn.ptit.pttkm3.web.SecuritySupport" %>
<% ImportDraft draft=(ImportDraft)request.getAttribute("draft"); String error=(String)request.getAttribute("error"),q=(String)request.getAttribute("titleQuery"); Integer pageNumber=(Integer)request.getAttribute("titlePageNumber"); if(pageNumber==null)pageNumber=1; boolean metadataError=error!=null&&(error.contains("Tên đầu truyện")||error.contains("Thông tin đầu truyện")),yearError=error!=null&&error.contains("Năm xuất bản"); %>
<!doctype html>
<html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Thêm đầu truyện mới · Truyện Nhà Mình</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head>
<body><jsp:include page="/WEB-INF/views/partials/top.jsp" /><main class="wrap">
  <div class="page-intro"><div class="eyebrow">Nhập truyện · Đầu truyện mới</div><h1>Thông tin đầu truyện</h1><p class="lead">Thông tin được giữ trong phiếu tạm. Đầu truyện chỉ được ghi vào danh mục khi lưu hóa đơn nhập.</p></div>
  <% if(error!=null){ %><div id="error-summary" class="alert error" role="alert" tabindex="-1"><strong>Chưa thể thêm đầu truyện.</strong><br><%=SecuritySupport.escape(error)%></div><script>document.getElementById('error-summary').focus();</script><% } %>
  <form class="card card-body form-grid" method="post" action="${pageContext.request.contextPath}/app/imports/title/stage">
    <input type="hidden" name="_csrf" value="<%=SecuritySupport.escape((String)request.getAttribute("csrfToken"))%>"><input type="hidden" name="draftId" value="<%=SecuritySupport.escape(draft.id())%>"><input type="hidden" name="version" value="<%=draft.version()%>"><input type="hidden" name="q" value="<%=SecuritySupport.escape(q)%>"><input type="hidden" name="page" value="<%=pageNumber%>">
    <div class="field"><label for="new-name">Tên đầu truyện <span class="req">*</span></label><input id="new-name" name="name" maxlength="255" value="<%=SecuritySupport.escape(request.getParameter("name"))%>" required autocomplete="off" <%=metadataError?"aria-invalid=\"true\" aria-describedby=\"metadata-error\"":""%>><%if(metadataError){%><p class="field-error" id="metadata-error"><%=SecuritySupport.escape(error)%></p><%}%></div>
    <div class="field"><label for="new-author">Tác giả <span class="req">*</span></label><input id="new-author" name="author" maxlength="255" value="<%=SecuritySupport.escape(request.getParameter("author"))%>" required <%=metadataError?"aria-invalid=\"true\" aria-describedby=\"metadata-error\"":""%>></div>
    <div class="field"><label for="new-category">Thể loại <span class="req">*</span></label><input id="new-category" name="category" maxlength="255" value="<%=SecuritySupport.escape(request.getParameter("category"))%>" required <%=metadataError?"aria-invalid=\"true\" aria-describedby=\"metadata-error\"":""%>></div>
    <div class="field"><label for="new-publisher">Nhà xuất bản <span class="req">*</span></label><input id="new-publisher" name="publisher" maxlength="255" value="<%=SecuritySupport.escape(request.getParameter("publisher"))%>" required <%=metadataError?"aria-invalid=\"true\" aria-describedby=\"metadata-error\"":""%>></div>
    <div class="field"><label for="new-year">Năm xuất bản</label><input id="new-year" name="year" type="number" min="1" max="<%=java.time.Year.now().getValue()%>" value="<%=SecuritySupport.escape(request.getParameter("year"))%>" <%=yearError?"aria-invalid=\"true\" aria-describedby=\"year-error\"":""%>><%if(yearError){%><p class="field-error" id="year-error"><%=SecuritySupport.escape(error)%></p><%}%><span class="field-help">Có thể để trống nếu chưa có thông tin.</span></div>
    <div class="footer-actions"><a class="btn" href="${pageContext.request.contextPath}/app/imports/titles?id=<%=SecuritySupport.escape(draft.id())%>&amp;q=<%=java.net.URLEncoder.encode(q==null?"":q,java.nio.charset.StandardCharsets.UTF_8)%>&amp;page=<%=pageNumber%>">Hủy</a><button class="btn primary" type="submit">Thêm đầu truyện mới</button></div>
  </form>
</main></body></html>
