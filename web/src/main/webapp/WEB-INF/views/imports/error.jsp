<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="vn.ptit.pttkm3.web.SecuritySupport" %>
<%String draftId=(String)request.getAttribute("draftId"); boolean hasDraft=draftId!=null&&draftId.matches("[0-9a-fA-F-]{36}");%>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Chưa thể xử lý phiếu nhập</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head>
<body><jsp:include page="/WEB-INF/views/partials/top.jsp" /><main class="wrap"><section class="card card-body" style="max-width:720px;margin:32px auto"><div class="eyebrow">Nhập truyện</div><h1>Chưa thể xử lý phiếu nhập</h1><div class="alert error" role="alert">Hệ thống chưa lưu được thay đổi. Giao dịch đã được hoàn tác. Phiếu tạm vẫn được giữ để bạn thử lại.</div><p class="muted">Mã yêu cầu: <code><%=SecuritySupport.escape((String)request.getAttribute("requestId"))%></code></p><div class="footer-actions" style="margin-top:20px"><%if(hasDraft){%><a class="btn primary" href="${pageContext.request.contextPath}/app/imports/draft?id=<%=SecuritySupport.escape(draftId)%>">Mở lại phiếu và thử lại</a><%}%><a class="btn" href="${pageContext.request.contextPath}/app/home">Trang chính</a></div></section></main></body></html>
