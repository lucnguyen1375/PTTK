<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.text.NumberFormat,java.util.Locale,vn.ptit.pttkm3.service.SupplierReportSnapshot,vn.ptit.pttkm3.model.SupplierRevenue,vn.ptit.pttkm3.model.ReturnInvoiceRevenue,vn.ptit.pttkm3.model.ReturnRevenueLine,vn.ptit.pttkm3.model.NhaCungCap,vn.ptit.pttkm3.web.SecuritySupport" %>
<%SupplierReportSnapshot snapshot=(SupplierReportSnapshot)request.getAttribute("snapshot"); SupplierRevenue summary=(SupplierRevenue)request.getAttribute("summary"); NhaCungCap supplier=(NhaCungCap)request.getAttribute("supplier"); ReturnInvoiceRevenue invoice=(ReturnInvoiceRevenue)request.getAttribute("invoice"); NumberFormat money=NumberFormat.getIntegerInstance(Locale.forLanguageTag("vi-VN"));%>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Chi tiết <%=SecuritySupport.escape(invoice.invoiceCode())%> · Truyện Nhà Mình</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body>
<jsp:include page="/WEB-INF/views/partials/top.jsp" /><main class="wrap">
  <div class="page-intro"><div class="eyebrow">Thống kê · Chi tiết hóa đơn trả</div><h1>Hóa đơn <%=SecuritySupport.escape(invoice.invoiceCode())%></h1><p class="lead"><%=SecuritySupport.escape(supplier.getTenNCC())%> · <%=supplier.getMaNCC()%> · Ngày lập <%=invoice.invoiceDate().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy"))%></p></div>
  <section class="summary-grid" aria-label="Tổng quan hóa đơn">
    <div class="summary-item"><span>Nhà cung cấp</span><strong><%=SecuritySupport.escape(supplier.getTenNCC())%></strong></div>
    <div class="summary-item"><span>Số quyển trả</span><strong><%=invoice.lines().size()%></strong></div>
    <div class="summary-item"><span>Doanh thu hóa đơn</span><strong><%=money.format(invoice.revenue())%> ₫</strong></div>
  </section>
  <section class="card" style="margin-top:18px" aria-labelledby="invoice-lines-title"><div class="card-head"><h2 id="invoice-lines-title">Các quyển truyện được tính trong hóa đơn</h2><span class="small">Kỳ thống kê: <%=snapshot.from().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy"))%> – <%=snapshot.to().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy"))%></span></div>
    <p class="card-body muted">Doanh thu mỗi quyển được tính bằng giá thuê/ngày nhân với số ngày từ lúc mượn đến lúc trả, tối thiểu 1 ngày.</p>
    <div class="table-wrap"><table class="table"><thead><tr><th>Mã quyển</th><th>Đầu truyện</th><th>Phiếu mượn</th><th>Ngày mượn</th><th>Ngày trả</th><th class="numeric">Giá thuê/ngày</th><th class="numeric">Số ngày tính</th><th class="numeric">Doanh thu</th></tr></thead><tbody>
      <%for(ReturnRevenueLine line:invoice.lines()){%><tr><td class="code"><%=SecuritySupport.escape(line.copyCode())%></td><td><strong><%=SecuritySupport.escape(line.titleName())%></strong><div class="small"><%=SecuritySupport.escape(line.titleCode())%></div></td><td class="code"><%=SecuritySupport.escape(line.loanCode())%></td><td><%=line.loanDate().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy"))%></td><td><%=line.returnDate().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy"))%></td><td class="numeric"><%=money.format(line.dailyPrice())%> ₫</td><td class="numeric"><%=line.calendarDays()%></td><td class="numeric"><strong><%=money.format(line.revenue())%> ₫</strong></td></tr><%}%>
    </tbody></table></div><div class="total-row"><span>Tổng doanh thu hóa đơn trả</span><strong><%=money.format(invoice.revenue())%> ₫</strong></div>
  </section>
  <div class="footer-actions" style="margin-top:16px"><a class="btn" href="${pageContext.request.contextPath}/app/reports/suppliers/details?snapshot=<%=snapshot.id()%>&amp;supplierId=<%=supplier.getId()%>">Quay lại danh sách hóa đơn trả</a><a class="btn" href="${pageContext.request.contextPath}/app/reports/suppliers?snapshot=<%=snapshot.id()%>">Quay lại thống kê</a></div>
</main></body></html>
